{
  "name": "doh-primary-care-kpi",
  "version": "1.0.0",
  "description": "DOH Abu Dhabi JAWDA Primary Care KPI Dashboard - Local Application",
  "main": "server.js",
  "scripts": {
    "start": "npm run build && node server.js",
    "dev": "concurrently \"node server.js\" \"vite\"",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node smoke-test.js",
    "smoke": "node smoke-test.js",
    "lint": "eslint . --ext .js",
    "db:migrate": "node-pg-migrate up",
    "db:seed": "node seed_code_mappings_complete.js && node seed_kpi_definitions.js",
    "db:seed:mappings": "node seed_code_mappings_complete.js",
    "db:seed:kpis": "node seed_kpi_definitions.js",
    "db:backup": "node -e \"const fs=require('fs'); const d=new Date().toISOString().replace(/[:.]/g,'-'); fs.copyFileSync('database/kpi_data.db', `database/backups/kpi_data_${d}.db`); console.log('Backup created')\""
  },
  "keywords": [
    "DOH",
    "JAWDA",
    "KPI",
    "primary care",
    "Abu Dhabi"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "better-sqlite3": "^9.6.0",
    "bootstrap": "^5.3.3",
    "bootstrap-icons": "^1.11.3",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pdf-parse": "^1.1.1",
    "sqlite": "^5.1.1",
    "sqlite3": "^5.1.7",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "eslint": "^9.0.0",
    "node-pg-migrate": "^7.0.0",
    "vite": "^5.0.0"
  }
}
